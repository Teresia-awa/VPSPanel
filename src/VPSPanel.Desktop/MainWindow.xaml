<Window x:Class="VPSPanel.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:VPSPanel.Desktop"
 Title="VPS 代理管理面板" Width="1100" Height="650" MinWidth="900" MinHeight="510"
 WindowStartupLocation="CenterScreen" Language="zh-CN" UseLayoutRounding="True"
 Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Themes/OverviewLight.xaml"/>
  </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Grid Background="{DynamicResource OverviewBackdrop}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel Margin="6,16,8,10">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="10,2,0,17">
        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE774;" FontSize="22" VerticalAlignment="Center"/>
        <TextBlock Text="VPS 代理管理面板" FontSize="16" FontWeight="Medium" Margin="10,0,0,0"/>
      </StackPanel>
      <DockPanel DockPanel.Dock="Bottom" Margin="10,12,2,1">
        <Ellipse x:Name="SideDot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="SideStatus" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
      </DockPanel>
      <Separator DockPanel.Dock="Top" Margin="7,0,3,6"/>
      <ListBox x:Name="Nav" SelectionChanged="OnNavigation" AutomationProperties.Name="导航"
               BorderThickness="0" Background="{x:Null}" SelectedIndex="0">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Item" CornerRadius="5" Margin="0,1" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"><Grid>
              <Border x:Name="Indicator" Background="{DynamicResource OverviewDown}" Width="3" Height="17" CornerRadius="2" HorizontalAlignment="Left" Visibility="Collapsed"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Grid></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource OverviewNavSelected}"/><Setter TargetName="Indicator" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
        </Style></ListBox.ItemContainerStyle>
        <ListBoxItem AutomationProperties.Name="首页" AutomationProperties.AutomationId="HomeNav" Padding="12,10">
          <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE80F;" Margin="0,0,12,0"/><TextBlock Text="首页"/></StackPanel>
        </ListBoxItem>
        <ListBoxItem AutomationProperties.Name="出口管理" AutomationProperties.AutomationId="ExitsNav" Padding="12,10">
          <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE898;" Margin="0,0,12,0"/><TextBlock Text="出口管理"/></StackPanel>
        </ListBoxItem>
        <ListBoxItem AutomationProperties.Name="规则与测试" Padding="12,10"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8FD;" Margin="0,0,12,0"/><TextBlock Text="规则与测试"/></StackPanel></ListBoxItem>
        <ListBoxItem AutomationProperties.Name="备份与迁移" Padding="12,10"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" Margin="0,0,12,0"/><TextBlock Text="备份与迁移"/></StackPanel></ListBoxItem>
        <ListBoxItem AutomationProperties.Name="设置" AutomationProperties.AutomationId="SettingsNav" Padding="12,10">
          <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" Margin="0,0,12,0"/><TextBlock Text="设置"/></StackPanel>
        </ListBoxItem>
      </ListBox>
    </DockPanel>
    <Border Grid.Column="1" Margin="5,9,12,10" CornerRadius="10">
      <Border.Style><Style TargetType="Border">
        <Setter Property="Padding" Value="22,18"/><Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex,ElementName=Nav}" Value="0">
          <Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="{x:Null}"/>
        </DataTrigger></Style.Triggers>
      </Style></Border.Style>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel x:Name="PageHeader" Visibility="Collapsed" Margin="0,0,0,12">
          <Button x:Name="BackButton" Content="‹  返回总览" Visibility="Collapsed" Click="BackToOverview" Margin="0,0,12,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="PageTitle" Text="首页" FontSize="24" FontWeight="SemiBold"/>
        </DockPanel>
        <local:DashboardView x:Name="Overview" Grid.Row="1"/>
        <local:ConnectionView x:Name="HomePage" Grid.Row="1" Visibility="Collapsed"/>
        <local:ExitsView x:Name="ExitsPage" Grid.Row="1" Visibility="Collapsed"/>
        <local:RulesView x:Name="RulesPage" Grid.Row="1" Visibility="Collapsed"/>
        <local:MigrationView x:Name="MigrationPage" Grid.Row="1" Visibility="Collapsed"/>
        <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="外观" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <Border Style="{StaticResource PanelCard}">
            <DockPanel>
              <ComboBox x:Name="ThemePicker" DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="132"
                        AutomationProperties.Name="应用主题" AutomationProperties.AutomationId="ThemePicker" SelectionChanged="OnThemeChanged" SelectedValuePath="Tag">
                <ComboBoxItem Tag="System">跟随系统</ComboBoxItem>
                <ComboBoxItem Tag="Light">浅色</ComboBoxItem>
                <ComboBoxItem Tag="Dark">深色</ComboBoxItem>
              </ComboBox>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="应用主题" FontWeight="SemiBold"/>
                <TextBlock Text="更改将在当前窗口立即生效。" TextWrapping="Wrap" Margin="0,4,12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <TextBlock Text="分流" FontWeight="SemiBold" Margin="0,16,0,8"/>
          <Border Style="{StaticResource PanelCard}"><StackPanel>
            <Label Content="出口不可用时" FontWeight="SemiBold" Padding="0" Target="{Binding ElementName=FailurePicker}"/>
            <TextBlock Text="绑定出口停用或探活失败时，新连接使用以下策略。直连从中转 VPS 发出。"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,8"/>
            <ComboBox x:Name="FailurePicker" HorizontalAlignment="Left" MinWidth="220" MaxWidth="350"
                      DisplayMemberPath="Label" SelectedValuePath="Policy" SelectionChanged="FailureChanged" AutomationProperties.Name="出口不可用时"/>
            <TextBlock x:Name="FailureNotice" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
            <local:PublishView x:Name="FailurePublisher"/>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</Window>
