<UserControl x:Class="VPSPanel.Desktop.RulesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VPSPanel.Desktop">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <Border Style="{StaticResource PanelCard}"><StackPanel>
   <TabControl x:Name="Tabs" ItemContainerStyle="{StaticResource SnapshotTab}" BorderThickness="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
    <TabItem Header="网站规则"><StackPanel>
     <WrapPanel Margin="0,10"><Button Content="添加规则" Click="NewRule" Style="{StaticResource PanelAccentButton}"/><Button Content="编辑" Click="EditRule" Margin="6,0"/><Button Content="删除" Click="RemoveRule"/><Button Content="上移" Click="MoveUp" Margin="12,0,6,0"/><Button Content="下移" Click="MoveDown"/></WrapPanel>
     <DataGrid x:Name="Rules" Style="{StaticResource ReadTable}" MinHeight="82" AllowDrop="True" PreviewMouseLeftButtonDown="DragStart" MouseMove="DragMove" Drop="Dropped" MouseDoubleClick="EditRule">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="启用" Width="62"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox HorizontalAlignment="Center" IsChecked="{Binding Enabled,Mode=OneWay}" Click="ToggleRule"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="规则" ElementStyle="{StaticResource GridText}" Binding="{Binding Name}"/><DataGridTextColumn Header="匹配条件 / 规则集" Width="2*" ElementStyle="{StaticResource GridText}" Binding="{Binding Conditions}"/><DataGridTextColumn Header="动作" ElementStyle="{StaticResource GridText}" Binding="{Binding Action}"/><DataGridTextColumn Header="绑定出口" ElementStyle="{StaticResource GridText}" Binding="{Binding Exit}"/>
      </DataGrid.Columns>
     </DataGrid>
     <WrapPanel Margin="4,10">
      <Label Content="未命中以上规则时的默认动作" Target="{Binding ElementName=DefaultRoute}" VerticalAlignment="Center" Padding="0,0,12,0"/>
      <ComboBox x:Name="DefaultRoute" MinWidth="170" MaxWidth="300" DisplayMemberPath="Label" SelectionChanged="DefaultRouteChanged"
                AutomationProperties.Name="未命中规则的默认动作" ToolTip="选择后自动保存到本地主机草稿"/>
      <TextBlock x:Name="DefaultNotice" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
     </WrapPanel>
    </StackPanel></TabItem>
    <TabItem Header="规则集"><StackPanel>
     <WrapPanel Margin="0,10"><Button Content="新建 / 批量导入" Click="NewGroup" Style="{StaticResource PanelAccentButton}"/><Button Content="查看 / 编辑" Click="EditGroup" Margin="6,0"/><Button Content="删除" Click="RemoveGroup"/><Button Content="导入 Geo 数据…" Margin="12,0" Click="ImportGeo"/></WrapPanel>
     <DataGrid x:Name="Groups" Style="{StaticResource ReadTable}" MinHeight="82" MouseDoubleClick="EditGroup"><DataGrid.Columns>
      <DataGridTemplateColumn Header="启用" Width="62"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox HorizontalAlignment="Center" IsChecked="{Binding Enabled,Mode=OneWay}" Click="ToggleGroup"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="名称" ElementStyle="{StaticResource GridText}" Binding="{Binding Name}"/><DataGridTextColumn Header="匹配条件" Width="3*" ElementStyle="{StaticResource GridText}" Binding="{Binding Conditions}"/>
     </DataGrid.Columns></DataGrid>
    </StackPanel></TabItem>
   </TabControl>
   <TextBlock x:Name="Review" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
  </StackPanel></Border>
  <Border Style="{StaticResource PanelCard}" Margin="0,12,0,0"><StackPanel>
   <TextBlock Text="测试目标" FontSize="18" FontWeight="SemiBold"/><Label Content="域名或 IP" Target="{Binding ElementName=Target}"/>
   <DockPanel><Button DockPanel.Dock="Right" Content="读取 Relay 快照" Click="ReadStatus" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="打开离线快照…" Click="OpenStatus" Margin="8,0,0,0"/><TextBox x:Name="Target" TextChanged="TargetChanged"/></DockPanel>
   <TextBlock x:Name="Preview" Margin="0,10,0,2" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel></Border>
  <Border Style="{StaticResource PanelCard}" Margin="0,12,0,0"><StackPanel>
    <Expander x:Name="OverallLimit" Header="整体双向限速"><WrapPanel Margin="0,8"><CheckBox x:Name="Limited" Content="启用限速"/><Label Content="上传 Mbps"/><TextBox x:Name="Up" Width="72"/><Label Content="下载 Mbps"/><TextBox x:Name="Down" Width="72"/><Button Margin="8,0" Content="保存" Click="SaveLimit"/></WrapPanel></Expander>
    <WrapPanel Margin="0,8,0,0"><Button Content="导出规则与限速方案…" Click="Export"/><Button Content="应用到本机隔离 Relay" Margin="8,0" Click="ApplyLab" ToolTip="同步当前出口、规则与限速草稿，仅接受回环 IP"/></WrapPanel>
    <local:PublishView x:Name="Publisher"/>
   </StackPanel></Border>
  <TextBlock x:Name="Notice" Margin="4,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
 </StackPanel></ScrollViewer>
</UserControl>
