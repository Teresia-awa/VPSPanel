<UserControl x:Class="VPSPanel.Desktop.ConnectionView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel>
   <Border Style="{StaticResource PanelCard}">
    <StackPanel>
     <TextBlock Text="中转 VPS" FontSize="18" FontWeight="SemiBold"/>
     <StackPanel x:Name="LoginFields">
     <WrapPanel Margin="0,12,0,4">
      <RadioButton x:Name="AliasMode" Content="SSH 别名" GroupName="ConnectionMode" IsChecked="True" Checked="ModeChanged"/>
      <RadioButton x:Name="DirectMode" Content="主机直连" GroupName="ConnectionMode" Margin="18,0" Checked="ModeChanged"/>
     </WrapPanel>
     <Grid x:Name="AliasFields" Margin="0,6,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,10,0"><Label Target="{Binding ElementName=HostBox}" Content="SSH 别名或主机地址"/><TextBox x:Name="HostBox"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,10,0"><Label Target="{Binding ElementName=Account}" Content="SSH 用户"/><TextBox x:Name="Account" ToolTip="留空沿用 OpenSSH 配置"/></StackPanel>
      <StackPanel Grid.Column="2" Margin="0,0,10,0"><Label Target="{Binding ElementName=PortBox}" Content="SSH 端口"/><TextBox x:Name="PortBox" ToolTip="留空沿用别名配置或默认 22"/></StackPanel>
      <StackPanel Grid.Column="3"><Label Target="{Binding ElementName=Service}" Content="服务单元名"/><TextBox x:Name="Service" Text="xray-relay"/></StackPanel>
     </Grid>
     <StackPanel x:Name="DirectFields" Visibility="Collapsed" Margin="0,6,0,12">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,10,0"><Label Target="{Binding ElementName=Address}" Content="主机 IP 或域名"/><TextBox x:Name="Address" TextChanged="IdentityChanged"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,10,0"><Label Target="{Binding ElementName=DirectPort}" Content="SSH 端口"/><TextBox x:Name="DirectPort" Text="22" TextChanged="IdentityChanged"/></StackPanel>
       <StackPanel Grid.Column="2" Margin="0,0,10,0"><Label Target="{Binding ElementName=DirectUser}" Content="用户名"/><TextBox x:Name="DirectUser" TextChanged="IdentityChanged"/></StackPanel>
       <StackPanel Grid.Column="3"><Label Target="{Binding ElementName=DirectService}" Content="服务单元名"/><TextBox x:Name="DirectService" Text="xray-relay"/></StackPanel>
      </Grid>
      <WrapPanel Margin="0,12,0,8">
       <RadioButton x:Name="PasswordMode" Content="密码登录" IsChecked="True" GroupName="Authentication" Checked="ModeChanged"/>
       <RadioButton x:Name="KeyMode" Content="指定私钥文件" Margin="18,0" GroupName="Authentication" Checked="ModeChanged"/>
      </WrapPanel>
      <StackPanel x:Name="PasswordFields">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><Label Target="{Binding ElementName=LoginSecret}" Content="SSH 密码"/><PasswordBox x:Name="LoginSecret"/></StackPanel>
        <ContentControl x:Name="PasswordActions" Grid.Column="1" VerticalAlignment="Bottom" HorizontalContentAlignment="Stretch" Margin="12,0,0,0"/>
       </Grid>
       <CheckBox x:Name="Remember" Content="记住密码" Margin="0,8,0,0" Unchecked="Forget"/>
       <TextBlock x:Name="SavedHint" Text="已保存密码，留空即可使用。" Visibility="Collapsed" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
      </StackPanel>
      <Grid x:Name="KeyFields" Visibility="Collapsed">
       <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,10,0"><Label Target="{Binding ElementName=KeyPath}" Content="本地私钥文件"/><DockPanel><Button DockPanel.Dock="Right" Content="浏览…" Margin="8,0,0,0" Click="ChooseKey"/><TextBox x:Name="KeyPath"/></DockPanel></StackPanel>
       <StackPanel Grid.Column="1"><Label Target="{Binding ElementName=KeySecret}" Content="私钥口令（可选）"/><PasswordBox x:Name="KeySecret"/></StackPanel>
      </Grid>
     </StackPanel>
     </StackPanel>
     <ContentControl x:Name="DefaultActions"><Grid x:Name="ActionButtons" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="ReadButton" Style="{StaticResource PanelAccentButton}" MinWidth="170" Content="只读读取配置" Click="Read"/><Button x:Name="CancelButton" Grid.Column="1" Margin="8,0" Content="取消" Click="Cancel" Visibility="Collapsed"/></Grid></ContentControl>
     <TextBlock x:Name="Notice" Margin="0,10,0,0" TextWrapping="Wrap" Text="使用本机 OpenSSH 与已信任的主机指纹。用户和端口可留空。" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
   </Border>
   <Border x:Name="Details" Visibility="Collapsed" Style="{StaticResource PanelCard}" Margin="0,12,0,0">
    <StackPanel>
     <TextBlock Text="最近一次只读快照" FontSize="18" FontWeight="SemiBold"/>
     <WrapPanel Margin="0,9,0,6"><Border Style="{StaticResource Badge}"><TextBlock x:Name="HostLabel"/></Border><Border Style="{StaticResource Badge}"><TextBlock x:Name="VersionLabel"/></Border><Border x:Name="SftpBadge" Style="{StaticResource Badge}"><TextBlock x:Name="SftpLabel"/></Border><TextBlock x:Name="ReadTime" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></WrapPanel>
     <TextBlock x:Name="Summary" TextWrapping="Wrap" Margin="0,2,0,10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
     <TabControl x:Name="SnapshotTabs" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderThickness="0" ItemContainerStyle="{StaticResource SnapshotTab}">
      <TabItem Header="入口"><DataGrid x:Name="Ingress" Style="{StaticResource ReadTable}"><DataGrid.Columns>
       <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="标识" Binding="{Binding Tag,Converter={StaticResource EmptyField}}"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="协议" Binding="{Binding Protocol,Converter={StaticResource EmptyField}}"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="传输安全" Binding="{Binding Security,Converter={StaticResource EmptyField}}"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="端口" Binding="{Binding Port,Converter={StaticResource EmptyField}}"/>
      </DataGrid.Columns></DataGrid></TabItem>
      <TabItem Header="出口与直连"><DataGrid x:Name="Outbounds" Style="{StaticResource ReadTable}"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="标识" Binding="{Binding Tag,Converter={StaticResource EmptyField}}"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="协议" Binding="{Binding Protocol,Converter={StaticResource EmptyField}}"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="类型" Binding="{Binding Kind,Converter={StaticResource EmptyField}}"/></DataGrid.Columns></DataGrid></TabItem>
      <TabItem Header="原有路由组"><DataGrid x:Name="Routes" Style="{StaticResource ReadTable}"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="顺序" Binding="{Binding Order}" Width="Auto"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="标识" Binding="{Binding DisplayTag}"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="动作" Binding="{Binding Action}"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="指向" Binding="{Binding Target,Converter={StaticResource EmptyField}}"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="匹配条件" Binding="{Binding DisplayMatch}" Width="2*"/></DataGrid.Columns></DataGrid></TabItem>
     </TabControl>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
