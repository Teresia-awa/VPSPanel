<Window x:Class="VPSPanel.Desktop.RuleEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="520" SizeToContent="Height" MaxHeight="730" WindowStartupLocation="CenterOwner" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
  <Label Content="名称"/><TextBox x:Name="TitleBox"/>
  <StackPanel x:Name="RuleFields"><Label Content="条件来源"/><ComboBox x:Name="Group" SelectionChanged="ChoiceChanged" DisplayMemberPath="Name" SelectedValuePath="Id"/>
   <Label Content="动作"/><ComboBox x:Name="ActionBox" SelectionChanged="ChoiceChanged"><ComboBoxItem Content="自动分摊"/><ComboBoxItem Content="中转机直连"/><ComboBoxItem Content="指定出口"/></ComboBox>
   <StackPanel x:Name="Bound"><Label Content="绑定出口"/><ComboBox x:Name="Exit" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
  </StackPanel>
  <StackPanel x:Name="Manual"><Label Content="匹配条件（每行一项）"/><TextBlock TextWrapping="Wrap" Text="支持 full:、domain:、ip:、geosite:、geoip:。无前缀域名按后缀匹配。"/><TextBox x:Name="Lines" AcceptsReturn="True" TextWrapping="Wrap" Height="128" VerticalScrollBarVisibility="Auto"/><Button Content="从文本文件追加…" HorizontalAlignment="Left" Click="Import" Margin="0,6"/></StackPanel>
  <TextBlock x:Name="ErrorText" TextWrapping="Wrap"/><WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0"><Button IsCancel="True" Content="取消" Margin="0,0,8,0"/><Button IsDefault="True" Content="保存" Style="{StaticResource PanelAccentButton}" Click="Save"/></WrapPanel>
 </StackPanel></ScrollViewer>
</Window>
