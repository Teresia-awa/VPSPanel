<Window x:Class="VPSPanel.Desktop.ChangeDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="620" Height="410" MinWidth="410" MinHeight="270" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <DockPanel Margin="20">
  <TextBlock DockPanel.Dock="Top" x:Name="Description" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0">
   <Button x:Name="Accept" Style="{StaticResource PanelAccentButton}" Click="Choose"/>
   <Button x:Name="Alternate" Click="Choose" Margin="6,0"/>
   <Button Content="取消" IsCancel="True"/>
  </WrapPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="Lines">
   <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="2,4"/></DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl></ScrollViewer>
 </DockPanel>
</Window>
